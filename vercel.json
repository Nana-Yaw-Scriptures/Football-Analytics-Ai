{
  "routes": [
    { 
      "src": "/sitemap.xml", 
      "dest": "/sitemap.xml",
      "headers": { "Content-Type": "application/xml" }
    },
    { 
      "src": "/robots.txt", 
      "dest": "/robots.txt",
      "headers": { "Content-Type": "text/plain" }
    },
    { "src": "/privacy.html", "dest": "/privacy.html" },
    { "src": "/google(.*)\\.html", "dest": "/google$1.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
